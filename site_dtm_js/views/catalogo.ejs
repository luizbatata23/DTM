<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>TDM | Catálogo</title>
  <link href="https://fonts.googleapis.comcss2?family=Roboto:wght@400;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="css/style.css">
</head>

<body>

  <header class="main-header">
  <div class="logo-container">
    <img src="/img/51 Sem Título_20250220100547.png" alt="Logo" class="logo-icon">
    <span class="logo-text">Tabuleiros do Mundo</span>
  </div>

  <nav class="main-nav" id="nav-list">
    <a href="/home" class="nav-link">Início</a>
    <a href="/catalogo" class="nav-link">Catálogo</a>
    <a href="/mapas" class="nav-link">Mapas</a>
    <a href="/sobre" class="nav-link">Sobre Nós</a>
  </nav>

  <div class="header-auth">
    <% if (usuario) { %>
      <span class="usuario-logado">👤 <%= usuario %></span>
      <a href="/logout" class="nav-link btn-logout">Sair</a>
    <% } else { %>
      <a href="/" class="nav-link login">Login</a>
    <% } %>
  </div>

  <div class="menu-toggle">
    <div class="bar"></div>
    <div class="bar"></div>
    <div class="bar"></div>
  </div>
</header>

  <main class="hero-section">
    <div class="hero-container">
      <img src="/img/51 Sem Título_20250220100547.png" alt="Logo" class="center-icon">
      <h1 class="hero-title">Descubra o Seu Próximo Jogo Favorito!</h1>
      <p class="hero-subtitle">Mais de 50 títulos catalogados.</p>

      <div class="filter-container">
        <div class="search-box">
          <span class="search-icon">🔍</span>
          <input type="text" id="searchInput" placeholder="Busque por nome...">
        </div>
        <div class="filter-box">
          <select id="categoryFilter">
            <option value="all">Todas as Categorias</option>
            <option value="estrategia">🧠 Estratégia</option>
            <option value="sorte">🎲 Sorte / Corrida</option>
            <option value="familia">👨‍👩‍👧‍👦 Família</option>
            <option value="infantil">🧸 Infantil</option>
          </select>
        </div>
      </div>

      <div class="game-grid">
        <% jogos.forEach(jogo=> { %>
          <div class="game-card" data-title="<%= jogo.titulo.toLowerCase() %>"
            data-category="<%= jogo.categoria.toLowerCase() %>">
            <div class="card-inner">

              <div class="card-front">
                <div class="game-image">
                  <img src="<%= jogo.imagem_url %>" alt="<%= jogo.titulo %>" class="game-img-obj">
                </div>
                <div class="game-info">
                  <h3 class="game-title">
                    <%= jogo.titulo %>
                  </h3>
                  <div class="game-details">
                    <span>⭐ <%= jogo.nota %></span>
                    <span> - </span>
                    <span>👥 <%= jogo.jogadores %></span>
                    <span> - </span>
                    <span>
                      <%= jogo.origem %>
                    </span>
                    <% if (jogo.latitude != null && jogo.longitude != null) { %>
                      <span> - </span>
                      <span>📍 mapeado</span>
                    <% } %>
                  </div>
                </div>
              </div>

              <div class="card-back">
  <h3 class="game-title">Resumo</h3>
  <p class="game-description"><%= jogo.historiaShort %></p>
  <a href="/tabuleiro?id=<%= jogo.id %>" class="btn-details">VER DETALHES</a>

  <% if (isAdmin) { %>
    <button class="btn-editar" onclick="abrirModalEditar({
      id: '<%= jogo.id %>',
      titulo: `<%= jogo.titulo.replace(/`/g, '') %>`,
      origem: `<%= (jogo.origem || '').replace(/`/g, '') %>`,
      jogadores: `<%= (jogo.jogadores || '').replace(/`/g, '') %>`,
      imagem_url: `<%= (jogo.imagem_url || '').replace(/`/g, '') %>`,
      categoria: '<%= jogo.categoria %>',
      nota: '<%= jogo.nota %>',
      latitude: '<%= jogo.latitude != null ? jogo.latitude : '' %>',
      longitude: '<%= jogo.longitude != null ? jogo.longitude : '' %>',
      historia: `<%= (jogo.historia || '').replace(/`/g, '').replace(/\n/g, ' ') %>`,
      regras: `<%= (jogo.regras || '').replace(/`/g, '').replace(/\n/g, ' ') %>`
    })">✏️ Editar</button>

    <form action="/catalogo/excluir/<%= jogo.id %>" method="POST"
          onsubmit="return confirmarExclusao('<%= jogo.titulo %>')">
      <button type="submit" class="btn-excluir">🗑 Excluir</button>
    </form>
  <% } %>
</div>

            </div>
          </div>
          <% }); %>
      </div>

    </div>
  <% if (isAdmin) { %>

  <!-- Botão flutuante de adicionar -->
  <button class="btn-add-jogo" onclick="abrirModal()">＋ Adicionar Jogo</button>

  <!-- Modal de ADICIONAR -->
  <div class="modal-overlay" id="modalOverlay" onclick="fecharModal(event)">
    <div class="modal-box">
      <h2>➕ Adicionar Novo Jogo</h2>
      <form action="/catalogo/adicionar" method="POST">
        <label>Título *</label>
        <input type="text" name="titulo" required placeholder="Ex: Xadrez">
        <label>Origem</label>
        <input type="text" name="origem" placeholder="Ex: Índia / Europa">
        <label>Jogadores</label>
        <input type="text" name="jogadores" placeholder="Ex: 2 jogadores">
        <label>URL da Imagem</label>
        <input type="text" name="imagem_url" placeholder="/img/nome.png">
        <label>Latitude</label>
        <input type="number" name="latitude" step="any" placeholder="Ex: -23.5505" min="-90" max="90">
        <label>Longitude</label>
        <input type="number" name="longitude" step="any" placeholder="Ex: -46.6333" min="-180" max="180">
        <small style="color: var(--text-light); font-size: 0.8rem; display: block; margin-bottom: 10px;">Use coordenadas decimais. Ex: São Paulo = -23.5505, -46.6333</small>
        <label>Categoria</label>
        <select name="categoria">
          <option value="estrategia">🧠 Estratégia</option>
          <option value="sorte">🎲 Sorte / Corrida</option>
          <option value="familia">👨‍👩‍👧‍👦 Família</option>
          <option value="infantil">🧸 Infantil</option>
        </select>
        <label>Nota (0 a 5)</label>
        <input type="number" name="nota" min="0" max="5" step="0.1" placeholder="Ex: 4.5">
        <label>História</label>
        <textarea name="historia" rows="3" placeholder="Conte a história do jogo..."></textarea>
        <label>Regras</label>
        <textarea name="regras" rows="3" placeholder="Descreva as regras principais..."></textarea>
        <div class="modal-actions">
          <button type="button" onclick="fecharModalBtn()">Cancelar</button>
          <button type="submit">Salvar Jogo</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Modal de EDITAR -->
  <div class="modal-overlay" id="modalEditarOverlay" onclick="fecharModalEditar(event)">
    <div class="modal-box">
      <h2>✏️ Editar Jogo</h2>
      <form id="formEditar" action="" method="POST">
        <label>Título *</label>
        <input type="text" name="titulo" id="edit-titulo" required>
        <label>Origem</label>
        <input type="text" name="origem" id="edit-origem">
        <label>Jogadores</label>
        <input type="text" name="jogadores" id="edit-jogadores">
        <label>URL da Imagem</label>
        <input type="text" name="imagem_url" id="edit-imagem_url">
        <label>Latitude</label>
        <input type="number" name="latitude" id="edit-latitude" step="any" placeholder="Ex: -23.5505" min="-90" max="90">
        <label>Longitude</label>
        <input type="number" name="longitude" id="edit-longitude" step="any" placeholder="Ex: -46.6333" min="-180" max="180">
        <small style="color: var(--text-light); font-size: 0.8rem; display: block; margin-bottom: 10px;">Use coordenadas decimais. Ex: São Paulo = -23.5505, -46.6333</small>
        <label>Categoria</label>
        <select name="categoria" id="edit-categoria">
          <option value="estrategia">🧠 Estratégia</option>
          <option value="sorte">🎲 Sorte / Corrida</option>
          <option value="familia">👨‍👩‍👧‍👦 Família</option>
          <option value="infantil">🧸 Infantil</option>
        </select>
        <label>Nota (0 a 5)</label>
        <input type="number" name="nota" id="edit-nota" min="0" max="5" step="0.1">
        <label>História</label>
        <textarea name="historia" id="edit-historia" rows="3"></textarea>
        <label>Regras</label>
        <textarea name="regras" id="edit-regras" rows="3"></textarea>
        <div class="modal-actions">
          <button type="button" onclick="fecharModalEditarBtn()">Cancelar</button>
          <button type="submit">Salvar Alterações</button>
        </div>
      </form>
    </div>
  </div>

<% } %>
  </main>

  <footer class="main-footer">
    <p>© 2025 Tabuleiros do Mundo.</p>
    <div class="footer-links">
      <a href="https://www.instagram.com/tabuleirosdomundo">Instagram</a>
    </div>
  </footer>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const searchInput = document.getElementById('searchInput');
      const categoryFilter = document.getElementById('categoryFilter');
      const cards = document.querySelectorAll('.game-card');

      function filterGames() {
        const searchTerm = searchInput.value.toLowerCase();
        const selectedCategory = categoryFilter.value.toLowerCase();

        cards.forEach(card => {
          const gameTitle = card.getAttribute('data-title');
          const gameCategory = card.getAttribute('data-category');
          const matchesSearch = gameTitle.includes(searchTerm);
          const matchesCategory = selectedCategory === 'all' || gameCategory === selectedCategory;

          card.style.display = (matchesSearch && matchesCategory) ? 'block' : 'none';
        });
      }

      searchInput.addEventListener('input', filterGames);
      categoryFilter.addEventListener('change', filterGames);
    });
    function abrirModal() {
      document.getElementById('modalOverlay').classList.add('ativo');
    }
    function fecharModalBtn() {
      document.getElementById('modalOverlay').classList.remove('ativo');
    }
    function fecharModal(event) {
      if (event.target.id === 'modalOverlay') {
        fecharModalBtn();
      }
    }
    function confirmarExclusao(titulo) {
      return confirm('Tem certeza que deseja excluir "' + titulo + '"?\nEssa ação não pode ser desfeita.');
    }
    function abrirModalEditar(jogo) {
  // Preenche o formulário com os dados do jogo
  document.getElementById('edit-titulo').value     = jogo.titulo;
  document.getElementById('edit-origem').value     = jogo.origem;
  document.getElementById('edit-jogadores').value  = jogo.jogadores;
  document.getElementById('edit-imagem_url').value = jogo.imagem_url;
  document.getElementById('edit-nota').value       = jogo.nota;
  document.getElementById('edit-latitude').value   = jogo.latitude || '';
  document.getElementById('edit-longitude').value  = jogo.longitude || '';
  document.getElementById('edit-historia').value   = jogo.historia;
  document.getElementById('edit-regras').value     = jogo.regras;

  // Seleciona a categoria correta no select
  const select = document.getElementById('edit-categoria');
  for (let opt of select.options) {
    opt.selected = (opt.value === jogo.categoria);
  }

  // Define a action do form com o id correto
  document.getElementById('formEditar').action = `/catalogo/editar/${jogo.id}`;

  // Abre o modal
  document.getElementById('modalEditarOverlay').classList.add('ativo');
}

function fecharModalEditarBtn() {
  document.getElementById('modalEditarOverlay').classList.remove('ativo');
}

function fecharModalEditar(event) {
  if (event.target.id === 'modalEditarOverlay') {
    fecharModalEditarBtn();
  }
}
  </script>
  <script src="js/script.js"></script>
</body>

</html>