<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>TDM | <%= jogo.titulo %>
  </title>
  <link rel="stylesheet" href="css/style.css">
  <style>
    body {
      background-color: var(--hero-bg-end);
      display: flex;
      flex-direction: column;
      min-height: 100vh;
    }

    main {
      flex: 1;
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding-bottom: 40px;
    }

    .info-container {
      width: 90%;
      max-width: 900px;
      margin: 30px auto;
      background: var(--card-glass);
      backdrop-filter: blur(15px);
      border: 1px solid rgba(255, 255, 255, 0.2);
      border-radius: 20px;
      padding: 40px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
      animation: fadeInUp 0.5s ease-out;
    }

    .info-img-wrapper {
      width: 100%;
      height: 350px;
      border-radius: 15px;
      overflow: hidden;
      margin-bottom: 25px;
      box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
    }

    .info-img-wrapper img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      transition: transform 0.5s;
    }

    .info-img-wrapper:hover img {
      transform: scale(1.05);
    }

    .hero-title {
      font-size: clamp(1.8rem, 5vw, 2.5rem);
      color: var(--text-dark);
      margin-bottom: 10px;
      text-align: center;
    }

    .info-stats {
      display: flex;
      flex-wrap: wrap;
      gap: 20px;
      margin-bottom: 30px;
      justify-content: center;
      font-weight: bold;
      color: var(--logo-gold);
      font-size: 1.1rem;
    }

    .info-section {
      margin-bottom: 30px;
      text-align: left;
    }

    .info-section h2 {
      font-size: 1.4rem;
      color: var(--text-dark);
      border-bottom: 2px solid rgba(179, 125, 0, 0.2);
      padding-bottom: 8px;
      margin-bottom: 15px;
    }

    .info-section p {
      line-height: 1.8;
      color: #4a4123;
      font-size: 1rem;
      text-align: justify;
    }

    .btn-voltar {
      display: inline-block;
      margin-top: 10px;
      text-decoration: none;
      color: var(--text-dark);
      border: 2px solid var(--logo-gold);
      padding: 12px 30px;
      border-radius: 50px;
      font-weight: bold;
      transition: 0.3s;
    }

    .btn-voltar:hover {
      background: var(--logo-gold);
      color: #fff;
      transform: translateY(-3px);
      box-shadow: 0 5px 15px rgba(179, 125, 0, 0.3);
    }

    @media (max-width: 768px) {
      .info-container {
        width: 95%;
        padding: 20px;
        margin: 20px auto;
      }

      .info-img-wrapper {
        height: 200px;
      }

      .info-stats {
        font-size: 0.9rem;
        gap: 15px;
      }

      .hero-title {
        font-size: 1.8rem;
      }

      .info-section p {
        text-align: left;
      }
    }

    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  </style>
</head>

<body>

  <header class="main-header">
    <div class="logo-container">
      <img src="/img/51 Sem Título_20250220100547.png" alt="Logo" class="logo-icon">
      <span class="logo-text">Tabuleiros do Mundo</span>
    </div>
    <div class="menu-toggle">
      <div class="bar"></div>
      <div class="bar"></div>
      <div class="bar"></div>
    </div>
    <nav class="main-nav" id="nav-list">
      <a href="/home" class="nav-link">Início</a>
      <a href="/catalogo" class="nav-link active">Catálogo</a>
      <a href="/mapas" class="nav-link">Mapas</a>
      <a href="/sobre" class="nav-link">Sobre Nós</a>
      <a href="/" class="nav-link login">Login</a>
    </nav>
  </header>

  <main>
    <div class="info-container">

      <div class="info-img-wrapper">
        <img src="<%= jogo.imagem_url %>" alt="<%= jogo.titulo %>">
      </div>

      <h1 class="hero-title">
        <%= jogo.titulo %>
      </h1>

      <div class="info-stats">
        <span><%= jogo.origem %></span>
        <span><%= jogo.jogadores %></span>
        <% if (jogo.latitude != null && jogo.longitude != null) { %>
          <span>📍 <%= Number(jogo.latitude).toFixed(2) %>, <%= Number(jogo.longitude).toFixed(2) %></span>
        <% } %>
      </div>

      <div class="info-section">
        <h2>📜 História e Origem</h2>
        <p><%- jogo.historia ? jogo.historia.replace(/\n/g, '<br>' ) : '' %></p>
      </div>

      <div class="info-section">
        <h2>⚔️ Regras do Jogo</h2>
        <p><%- jogo.regras ? jogo.regras.replace(/\n/g, '<br>' ) : '' %></p>
      </div>

      <div style="text-align: center;">
        <a href="/catalogo" class="btn-voltar">← Voltar para o Catálogo</a>
      </div>

    </div>
    <!-- Seção de Vídeos Tutoriais -->
<div class="info-section">
  <h2>🎬 Vídeos Tutoriais</h2>
  <p style="margin-bottom: 20px;">Aprenda a jogar assistindo aos tutoriais selecionados pela nossa equipe.</p>

  <div class="videos-grid">

    <!-- Para adicionar um vídeo, cole o link do YouTube e troque o ID -->
    <!-- Exemplo: https://www.youtube.com/watch?v=XXXXXXXXXXX → o ID é XXXXXXXXXXX -->

    <div class="video-wrapper">
      <iframe
        src="https://www.youtube.com/embed/VIDEO_ID_1"
        title="Tutorial <%= jogo.titulo %> - Parte 1"
        frameborder="0"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen>
      </iframe>
      <p class="video-label">Como jogar <%= jogo.titulo %></p>
    </div>
  </div>
</div>
  </main>

  <footer class="main-footer">
    <p>© 2026 Tabuleiros do Mundo.</p>
  </footer>

  <script src="js/script.js"></script>
</body>

</html>